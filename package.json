{
  "name": "mcp-ai-summit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local MCP workshop demo for AcmeShop",
  "scripts": {
    "dev": "concurrently -k -n API,MCP -c blue,magenta \"npm run api\" \"npm run mcp\"",
    "api": "tsx watch mock-api/src/server.ts",
    "mcp": "tsx mcp-server/src/server.ts",
    "reset": "tsx scripts/reset-data.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^5.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
